# Production web server: static files plus /api forwarded to team-ops-api on the same origin,
# so the Sanctum session cookie works (ADR-0008). ${API_UPSTREAM} is filled in at container start.

# Log the path only: no query string and no Referer, because mail links carry a one-time token
# in the query string and the next request's Referer still contains it (plan.md D7).
log_format path_only '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

# Behind Caddy (ADR-0022) the request arrived over HTTPS; pass that on so the API does not take it
# for plain HTTP. Only https is taken from the header, and only Caddy can reach this port on the server
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https https;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /dev/stdout path_only;

    # Behind Caddy (ADR-0022), take the client IP from its X-Forwarded-For. Only the address in
    # ${REAL_IP_FROM} is trusted, so a client cannot forge its IP for the API's rate limits
    set_real_ip_from ${REAL_IP_FROM};
    real_ip_header X-Forwarded-For;

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        # Overwrite (do not append) so a client cannot forge its IP for the API's rate limits.
        # $remote_addr is the client IP taken from a trusted proxy above, or the connecting address
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # The API trusts only For and Proto, but set the rest too so a client's own values never pass through
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Prefix "";
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Pages opened from mail links carry a one-time token in the query string.
    # Not logged at all (plan.md D7); the app also removes the token from the URL.
    location = /login/verify {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store";
        try_files /index.html =404;
    }
    location = /settings/email/verify {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store";
        try_files /index.html =404;
    }

    # Client-side routes (/login, /teams/...) all load the app
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
