# Production web server: static files plus /api forwarded to team-ops-api on the same origin,
# so the Sanctum session cookie works (ADR-0008). ${API_UPSTREAM} is filled in at container start.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        # Overwrite (do not append) so a client cannot forge its IP for the API's rate limits
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/login/verify, /teams/...) all load the app
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
